<?xml version="1.0" encoding="utf-8"?>
<!--
  Calculadora cambiaria (RemoteViews).
  Jerarquía: 1) dónde estoy y con qué tasas, 2) el monto, 3) el resultado de
  cada tasa, 4) el teclado. Todo dato mostrado es explicable: arriba va la tasa
  con la que se calculó, así el número no aparece de la nada.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_background">

    <!-- 1. Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CAMBIO · USD → Bs."
            android:letterSpacing="0.10"
            android:textColor="#7A7F7B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#0E7A54"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tasas usadas (hacen explicable el resultado) -->
    <TextView
        android:id="@+id/widget_rates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BCV — · P2P —"
        android:textColor="#7A7F7B"
        android:textSize="10sp" />

    <!-- 2. Monto -->
    <TextView
        android:id="@+id/widget_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:text="$ 0"
        android:textColor="#101312"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="#14000000"
        android:includeFontPadding="false" />

    <!-- 3. Resultado por tasa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:letterSpacing="0.08"
            android:text="BCV"
            android:textColor="#7A7F7B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_bcv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="—"
            android:textColor="#101312"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:letterSpacing="0.08"
            android:text="P2P"
            android:textColor="#7A7F7B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_p2p"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="—"
            android:textColor="#0E7A54"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. Teclado -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key_1" style="@style/WidgetKey" android:text="1" />
        <TextView android:id="@+id/key_2" style="@style/WidgetKey" android:text="2" />
        <TextView android:id="@+id/key_3" style="@style/WidgetKey" android:text="3" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key_4" style="@style/WidgetKey" android:text="4" />
        <TextView android:id="@+id/key_5" style="@style/WidgetKey" android:text="5" />
        <TextView android:id="@+id/key_6" style="@style/WidgetKey" android:text="6" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key_7" style="@style/WidgetKey" android:text="7" />
        <TextView android:id="@+id/key_8" style="@style/WidgetKey" android:text="8" />
        <TextView android:id="@+id/key_9" style="@style/WidgetKey" android:text="9" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/key_comma" style="@style/WidgetKey" android:text="," />
        <TextView android:id="@+id/key_0" style="@style/WidgetKey" android:text="0" />
        <TextView android:id="@+id/key_del" style="@style/WidgetKey" android:text="⌫" />
    </LinearLayout>
</LinearLayout>
